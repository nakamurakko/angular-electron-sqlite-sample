{
  "name": "angular-electron-sqlite-sample",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start:angular": "ng serve",
    "start:electron": "npm run build:all && electron ./dist/electron-main.js",
    "build:all": "npm run build:angular && npm run build:electron",
    "build:angular": "ng build --base-href ./",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build:development:all": "npm run build:development:angular && npm run build:development:electron",
    "build:development:angular": "ng build --configuration=development --base-href ./",
    "build:development:electron": "tsc --project tsconfig.electron.development.json",
    "build-portable": "npm run build:all && electron-builder build --windows portable",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.15.0",
  "dependencies": {
    "@angular/cdk": "22.1.3",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/material": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/router": "22.1.3",
    "rxjs": "7.8.2",
    "sqlite3": "5.1.7",
    "tslib": "2.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.3",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "main": "dist/electron-main.js",
  "build": {
    "asar": "false",
    "directories": {
      "output": "executableFile"
    },
    "files": [
      "!.angular",
      "!.github",
      "!.npmrc",
      "!.vscode",
      "!angular.json",
      "!build-dev.bat",
      "!build-portable.bat",
      "!database.sqlite",
      "!eslint.config.js",
      "!src",
      "!LICENSE",
      "!README.md",
      "!tsconfig*.json"
    ],
    "extraFiles": [
      "sample.png"
    ]
  }
}
